# URL Web App hasil `clasp deploy` di backend/
VITE_API_BASE_URL=https://script.google.com/macros/s/XXXXXXXX/exec

# OAuth Client ID dari Google Cloud Console (lihat docs/hak-akses.md) — dipakai
# untuk tombol "Sign in with Google". Harus sama dengan GOOGLE_OAUTH_CLIENT_ID
# di backend/Auth.gs.
VITE_GOOGLE_CLIENT_ID=xxxxxxxxxx.apps.googleusercontent.com
